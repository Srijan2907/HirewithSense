# Local development for the API (copy to apps/api/.env)
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgres://hws:hws@localhost:5433/hirewithsense
JWT_SECRET=dev-only-secret-change-me-please-0123456789abcdef
CLIENT_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Offline-friendly defaults: deterministic AI, Docker sandbox, database mailbox.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_ENABLE_AUDIO=false
CODE_RUNNER=docker
EMAIL_TRANSPORT=outbox
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
