{
  "name": "hirewithsense",
  "version": "2.0.0",
  "private": true,
  "description": "HireWithSense — AI-assisted technical interviewing platform (monorepo)",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @hws/api dev",
    "dev:web": "pnpm --filter @hws/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "db:generate": "pnpm --filter @hws/api db:generate",
    "db:migrate": "pnpm --filter @hws/api db:migrate",
    "db:seed": "pnpm --filter @hws/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
