PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGO_URL=mongodb://127.0.0.1:27017/hirewithsenseai
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d

# Create the first admin with: npm run seed:admin
ADMIN_NAME=Project Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-password

# Qwen / DashScope OpenAI-compatible endpoint and model.
# Verify the exact realtime model ID and API protocol for your Alibaba Cloud region.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_REALTIME_MODEL=qwen3.8-live-translate-flash-realtime

# Judge0-compatible API. Configure the host/base URL supplied by your provider.
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_AUTH_TOKEN=
JUDGE0_API_HOST=
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_MAX_POLLS=15
MAX_RESUME_MB=5
