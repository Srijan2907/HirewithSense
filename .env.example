PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGO_URL=mongodb://127.0.0.1:27017/hirewithsenseai
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d

# SMTP settings for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Create the first admin with: npm run seed:admin
ADMIN_NAME=Project Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-password

# OpenAI handles interviewer questions, answer feedback, reports, and code follow-ups.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gemini Flash parses resumes.
GEMINI_API_KEY=
GEMINI_RESUME_MODEL=gemini-2.5-flash

# Qwen handles realtime voice only.
QWEN_API_KEY=
QWEN_REALTIME_MODEL=qwen3.8-livetranslate-flash-realtime
QWEN_WORKSPACE_ID=
QWEN_REGION=singapore

# Judge0-compatible API. Configure the host/base URL supplied by your provider.
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_AUTH_TOKEN=
JUDGE0_API_HOST=
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_MAX_POLLS=15
MAX_RESUME_MB=5
